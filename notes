# generate synthetic data to understand decoder performance

PYTHONPATH=. python scripts/synthesize-decoder-inputs.py \
  --fna data/GCF_002042975.1_round0_test_query.fna.gz --tsv data/GCF_002042975.1_round0_test_annotations.tsv  \
  --dss-motifs standard \
  --start-tp 0.9,0.1 \
  --start-tn 0.02,0.01 \
  --stop-tp 0.9,0.1 \
  --stop-tn 0.02,0.01 \
  --dss-tp 0.9,0.1 \
  --dss-tn 0.02,0.01 \
  --ass-tp 0.9,0.1 \
  --ass-tn 0.02,0.01 \
  --output-pkl synthetic_decoder_input.pkl

PYTHONPATH=. python gene_decoder/decode.py --temperature-scale 1 --dss-motifs standard \
  --output-tsv x.tsv --output-fna x.fna \
  --min-prob 0.28 \
  --input-pkl synthetic_decoder_input.pkl

PYTHONPATH=. python gene_decoder/assess_decoding.py \
  --expected-tsv data/GCF_002042975.1_round0_test_annotations.tsv \
  --topk-boundaries 3 \
  --decoded-tsv x.tsv

