# prepare training and testing data

source chop_env/bin/activate && python scripts/merge-and-split-data.py \
  --tsv data/GCF_002042975.1_filtered_tcov0.99_evalue1e-20_annotations.tsv \
       data/GCF_000222465.1_filtered_tcov0.99_evalue1e-20_annotations.tsv \
  --fna data/GCF_002042975.1_filtered_tcov0.99_evalue1e-20_gene_context.fna.gz \
       data/GCF_000222465.1_filtered_tcov0.99_evalue1e-20_gene_context.fna.gz \
  --num-train 1000 --num-test 200 \
  --output-train-tsv data/train.tsv \
  --output-train-fna data/train.fna \
  --output-test-tsv data/test.tsv \
  --output-test-fna data/test.fna


# algae training, note dss-motifs specification

PYTHONPATH=. python gene_predictor/train.py \
  --fna-fn data/GCA_001939145.1_round0_train_query.fna.gz \
  --tsv-fn data/GCA_001939145.1_round0_train_annotations.tsv \
  --attention-masks "0:4,1:12,2:60,3:300:40:0" \
  --num-windows 20000 --stride 100 --stop-weight 8 --dss-motifs dino


# coral training, note dss-motifs specification

PYTHONPATH=. python gene_predictor/train.py \
  --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz \
  --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --attention-masks "0:4,1:12,2:60:12:60,3:140:40:140,4:220:120:0" \
  --num-windows 20000 --stride 330 --enable-cc --dss-motifs standard

PYTHONPATH=. python gene_predictor/list-class-windows.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --max-seq-length 1000 --num-windows 1000 --class DSS

PYTHONPATH=. python gene_predictor/window_validation.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --num-windows 20000 --window-stride 330 --dss-motifs standard \
  --run-dir gene_predictor/gene_predictor_run_20250930_202314 \
  --model-path model_epoch=22_val_f1=0.713.ckpt


# prediction using trained model

scripts/predict-layout GCF_002042975.1 253 gene_predictor/gene_predictor_run_20250930_202314 model_epoch=22_val_f1=0.713.ckpt


# viterbi decoder
 
PYTHONPATH=. python gene_decoder/build_codon_usage.py --fna data/GCF_002042975.1_round0_train_query.fna.gz --tsv data/GCF_002042975.1_round0_train_annotations.tsv --output data/GCF_002042975.1.codon_usage.json

PYTHONPATH=. python gene_decoder/decode.py --num-sequences 253 --temperature-scale 1 --dss-motifs standard \
  --output-tsv x.tsv --output-fna x.fna \
  --min-prob 0.28 \
  --input-pkl gene_predictor/gene_predictor_run_20250930_202314/prediction_20251003_143033_e36ad3c063_decoder.pickle 

PYTHONPATH=. python gene_decoder/assess_decoding.py \
  --expected-tsv data/GCF_002042975.1_round0_test_annotations.tsv \
  --topk-boundaries 3 \
  --decoded-tsv x.tsv 

PYTHONPATH=. python gene_decoder/event_probs.py \
  --dss-motifs standard \
  --expected-tsv data/GCF_002042975.1_round0_test_annotations.tsv \
  --output-tsv event_probs.tsv \
  --input-pkl gene_predictor/gene_predictor_run_20250930_202314/prediction_20251003_143033_e36ad3c063_decoder.pickle

PYTHONPATH=. python scripts/metrics-from-pickle.py \
  --dss-motifs standard \
  --fna-fn data/GCF_002042975.1_round0_test_query.fna.gz \
  --tsv-fn data/GCF_002042975.1_round0_test_annotations.tsv \
  --pickle-path gene_predictor/gene_predictor_run_20250930_202314/prediction_20251003_143033_e36ad3c063_decoder.pickle


# generate synthetic data to understand decoder performance

PYTHONPATH=. python scripts/synthesize-decoder-inputs.py \
  --fna data/GCF_002042975.1_round0_test_query.fna.gz --tsv data/GCF_002042975.1_round0_test_annotations.tsv  \
  --dss-motifs standard \
  --start-tp 0.9,0.1 \
  --start-tn 0.02,0.01 \
  --stop-tp 0.9,0.1 \
  --stop-tn 0.02,0.01 \
  --dss-tp 0.9,0.1 \
  --dss-tn 0.02,0.01 \
  --ass-tp 0.9,0.1 \
  --ass-tn 0.02,0.01 \
  --output-pkl synthetic_decoder_input.pkl

PYTHONPATH=. python gene_decoder/decode.py --temperature-scale 1 --dss-motifs standard \
  --output-tsv x.tsv --output-fna x.fna \
  --min-prob 0.28 \
  --input-pkl synthetic_decoder_input.pkl

PYTHONPATH=. python gene_decoder/assess_decoding.py \
  --expected-tsv data/GCF_002042975.1_round0_test_annotations.tsv \
  --topk-boundaries 3 \
  --decoded-tsv x.tsv

PYTHONPATH=. python scripts/synthesize-decoder-inputs.py \
  --tsv data/GCF_002042975.1_round0_test_annotations.tsv  \
  --dss-motifs standard \
  --start-tp 0.9,0.1 \
  --start-tn 0.02,0.01 \
  --input-pkl gene_predictor/gene_predictor_run_20251017_070259/prediction_20251018_160726_53e097c9f4_decoder.pickle \
  --output-pkl synthetic_decoder_input.pkl


# frequency analysis for flanking motifs of DSS and ASS

PYTHONPATH=. python scripts/analyze-flanking-motifs.py \
  --fna data/GCF_002042975.1_round0_train_query.fna.gz --tsv data/GCF_002042975.1_round0_train_annotations.tsv \
  --site both \
  --dss-motifs-mode standard \
  --flank 5

PYTHONPATH=. python scripts/analyze-flanking-motifs-from-pkl.py \
  --input-pkl gene_predictor/gene_predictor_run_20251017_070259/prediction_20251018_160726_53e097c9f4_decoder.pickle \
  --site both \
  --dss-motifs-mode standard \
  --flank 5


# augment existing pkl file with flank stats, boosting rather than override

PYTHONPATH=. python scripts/augment-decoder-inputs-from-flanks.py \
  --input-pkl gene_predictor/gene_predictor_run_20251018_174531/prediction_20251019_193935_53e097c9f4_decoder.pickle \
  --flank 4 --dss-motifs-mode standard \
  --flank-csv data/GCF_002042975.1_round0_train_ass_dss_flank4.csv \
  --mode override \
  --output-pkl synthetic_decoder_input.pkl


