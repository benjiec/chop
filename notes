# frequency analysis for flanking motifs of DSS and ASS

PYTHONPATH=. python scripts/analyze-flanking-motifs.py \
  --fna data/GCF_002042975.1_round0_train_query.fna.gz --tsv data/GCF_002042975.1_round0_train_annotations.tsv \
  --site both \
  --dss-motifs-mode standard \
  --flank 5

