# coral training, note dss-motifs specification

PYTHONPATH=. python gene_predictor/train.py \
  --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz \
  --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --attention-masks "0:4,1:12,2:60:12:0,3:140:40:0,4:220:120:0,5:0:12:60,6:0:40:140" \
  --dss-motifs standard --num-windows 0 --stride 330 \
  --loss-type event-head-bce \
  --start-weight 16 --start-neg-weight 1 --stop-weight 8 --stop-neg-weight 1 \
  --dss-weight 2 --dss-neg-weight 2 --ass-weight 2 --ass-neg-weight 2 \
  --start-alpha 1 --stop-alpha 2 --dss-alpha 3 --ass-alpha 3

# add for cross attention
  --aux-stream data/GCF_002042975.1_round0_train_stream_thermo.pkl.gz

PYTHONPATH=. python gene_predictor/list-class-windows.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --max-seq-length 1000 --num-windows 1000 --class DSS

PYTHONPATH=. python gene_predictor/window_validation.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv \
  --num-windows 20000 --window-stride 330 --dss-motifs standard \
  --run-dir gene_predictor/gene_predictor_run_20250930_202314 \
  --model-path model_epoch=22_val_f1=0.713.ckpt


# prediction using trained model

scripts/predict-layout GCF_002042975.1 253 gene_predictor/gene_predictor_run_20250930_202314 model_epoch=22_val_f1=0.713.ckpt standard
scripts/predict-layout-aux GCF_002042975.1 253 gene_predictor/gene_predictor_run_20250930_202314 model_epoch=22_val_f1=0.713.ckpt standard thermo

PYTHONPATH=. python gene_predictor/predict_and_analyze_inspect.py \
  --fna-fn data/GCF_002042975.1_round0_test_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_test_annotations.tsv  \
  --aux-stream data/GCF_002042975.1_round0_test_stream_thermo.pkl.gz \
  --dss-motifs standard \
  --num-contigs 20 \
  --run-dir gene_predictor/gene_predictor_run_20251026_212218 \
  --model-path model_epoch=03_val_loss=0.017.ckpt

# additional flags to look at more cross attention metrics
  --channel-ablation
  --grad-attr


# viterbi decoder
 
PYTHONPATH=. python gene_decoder/build_codon_usage.py --fna data/GCF_002042975.1_round0_train_query.fna.gz --tsv data/GCF_002042975.1_round0_train_annotations.tsv --output data/GCF_002042975.1.codon_usage.json

PYTHONPATH=. python gene_decoder/decode.py --num-sequences 253 --temperature-scale 1 --dss-motifs standard \
  --output-tsv x.tsv --output-fna x.fna \
  --min-prob 0.28 \
  --input-pkl gene_predictor/gene_predictor_run_20250930_202314/prediction_20251003_143033_e36ad3c063_decoder.pickle 

PYTHONPATH=. python gene_decoder/assess_decoding.py \
