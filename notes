# prep data

source chop_env/bin/activate && python scripts/merge-and-split-data.py \
  --tsv data/GCF_002042975.1_filtered_tcov0.99_evalue1e-20_annotations.tsv \
       data/GCF_000222465.1_filtered_tcov0.99_evalue1e-20_annotations.tsv \
  --fna data/GCF_002042975.1_filtered_tcov0.99_evalue1e-20_gene_context.fna.gz \
       data/GCF_000222465.1_filtered_tcov0.99_evalue1e-20_gene_context.fna.gz \
  --num-train 1000 --num-test 200 \
  --output-train-tsv data/train.tsv \
  --output-train-fna data/train.fna \
  --output-test-tsv data/test.tsv \
  --output-test-fna data/test.fna

# algae

PYTHONPATH=. python gene_predictor/train.py --fna-fn data/GCA_001939145.1_round0_train_query.fna.gz --tsv-fn data/GCA_001939145.1_round0_train_annotations.tsv --attention-masks "0:4,1:12,2:60,3:300:40:0" --num-windows 20000 --stride 100 --stop-weight 8 --dss-motifs dino

scripts/predict-layout GCA_001939145.1 99 gene_predictor/gene_predictor_run_20250928_142721 model_epoch=04_val_f1=0.224.ckpt


# coral

PYTHONPATH=. python gene_predictor/train.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv --attention-masks "0:4,1:12,2:60:12:60,3:140:40:140,4:220:120:0" --num-windows 20000 --stride 330 --enable-cc --dss-motifs standard

PYTHONPATH=. python gene_predictor/window_validation.py --fna-fn data/GCF_002042975.1_round0_train_query.fna.gz --tsv-fn data/GCF_002042975.1_round0_train_annotations.tsv --run-dir gene_predictor/gene_predictor_run_20250930_071840 --model-path model_epoch=06_val_f1=0.427.ckpt --num-windows 2000 --window-stride 330

# predict on 10, change to 1000 to do a full prediction
scripts/predict-layout GCF_002042975.1 10 gene_predictor/gene_predictor_run_20250930_202314 model_epoch=22_val_f1=0.713.ckpt

PYTHONPATH=. python gene_decoder/build_codon_usage.py --fna data/GCF_002042975.1_round0_train_query.fna.gz --tsv data/GCF_002042975.1_round0_train_annotations.tsv --output data/GCF_002042975.1.codon_usage.json

PYTHONPATH=. python gene_decoder/decode.py --min-prob 0.5 --num-sequences 253 --temperature-scale 3 --dss-motifs standard \
  --output-tsv x.tsv --output-fna x.fna \
  --input-pkl gene_predictor/gene_predictor_run_20250930_202314/prediction_20251003_143033_e36ad3c063_decoder.pickle 

PYTHONPATH=. python gene_decoder/assess_decoding.py \
  --expected-tsv data/GCF_002042975.1_round0_test_annotations.tsv \
  --topk-starts 3 \
  --decoded-tsv x.tsv 
