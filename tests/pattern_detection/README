# Test ATG with uniform background (all Cs)
python tests/pattern_detection/test_simple_atg_detection.py --background uniform --class-weights

# Test ATG with random sequences as background
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights

# Test ATG with same model as controlled UTR
python tests/pattern_detection/test_simple_atg_detection.py --d-model 504 --layers 3 --heads 6

# Test ATG, with attention mask
python tests/pattern_detection/test_simple_atg.py --attention-masks "0:1,1:2" --class-weights

# Test Controlled UTRs with different model sizes
python tests/pattern_detection/test_controlled_utr.py --d-model 256 --layers 4 --heads 8

# Test Controlled UTRs with stronger class weights
python tests/pattern_detection/test_controlled_utr.py --class-weights --utr-weight 5.0

# Test Controlled UTRs with attention masks
python tests/pattern_detection/test_controlled_utr.py --attention-masks "0:1,1:2,2:5" --class-weights
