# Test ATG with uniform background (all Cs)
python tests/pattern_detection/test_simple_atg_detection.py --background uniform --class-weights

# Test ATG with random sequences as background, smaller model
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights --d-model 256 --layers 3 --heads 4

# Test ATG 3-kmer convolution
# Expecting Sensitivity 100%, Precision 84%, Specificity 92%
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights --kmer 3

# Test ATG 9-kmer convolution
# Expecting Sensitivity 100%, Precision 100%, Specificity 100%
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights --kmer 9

# Test ATG attention mask +/- 1bp for 1st head, +/- 4bp for 2nd head
# Expecting Sensitivity 100%, Precision 100%, Specificity 100%
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights --attention-masks "0:1,1:4"

# Test ATG attention mask +/- 4bp for 1st head, +/- 8bp for 2nd head
# Expecting Sensitivity 100%, Precision 98%, Specificity 99%
python tests/pattern_detection/test_simple_atg_detection.py --background random --class-weights --attention-masks "0:4,1:8"

# Test UTRs with C's in the background, higher UTR weight
python tests/pattern_detection/test_controlled_utr.py --class-weights --utr-weight 5.0

# Test UTRs with C's in the background, 3-kmer convolution
# Expecting UTR5 Sensitivity 71%, Precision 67%, Specificity 97%
python tests/pattern_detection/test_controlled_utr.py --class-weights --kmer 3

# Test UTRs with C's in the background, 9-kmer convolution
# Expecting UTR5 Sensitivity 94%, Precision 94%, Specificity 99%
python tests/pattern_detection/test_controlled_utr.py --class-weights --kmer 9

# Test UTRs with C's in the background, attention mask +/- 1bp for 1st head, +/- 4bp for 2nd head
# Expecting UTR5 Sensitivity 82%, Precision 78%, Specificity 99%
python tests/pattern_detection/test_controlled_utr.py --class-weights --attention-masks "0:1,1:4"

# Test UTRs with C's in the background, attention mask +/- 4bp for 1st head, +/- 8bp for 2nd head
# Expecting UTR5 Sensitivity 90%, Precision 90%, Specificity 99%
python tests/pattern_detection/test_controlled_utr.py --class-weights --attention-masks "0:4,1:8"
